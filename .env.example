# Salin menjadi .env lalu isi nilainya.

# --- Database ---
# Untuk lokal (XAMPP): user root tanpa kata sandi, database dibuat lewat phpMyAdmin.
DATABASE_URL=mysql://root:@localhost:3306/jejak_audit
# Untuk Docker: kata sandi database MariaDB (DATABASE_URL di atas diabaikan oleh docker-compose).
DB_PASSWORD=ganti-dengan-kata-sandi-kuat
DB_ROOT_PASSWORD=ganti-dengan-kata-sandi-root-kuat

# Rahasia untuk sesi login, minimal 32 karakter acak. Wajib di server production.
# Buat dengan: openssl rand -hex 32
JWT_SECRET=

# Akun admin pertama, dibuat otomatis saat aplikasi pertama kali jalan.
ADMIN_EMAIL=admin@perusahaan.co.id
ADMIN_PASSWORD=ganti-segera-setelah-login
ADMIN_NAME=Administrator
# Username untuk masuk (bisa juga masuk dengan email)
ADMIN_USERNAME=admin
# Akun admin hanya untuk pengaturan. Untuk ikut mengerjakan audit, dibuat juga akun user terpisah
# dengan password yang sama: username <ADMIN_USERNAME>.user dan email alias +user
# (misalnya admin+user@perusahaan.co.id). Peran: auditor, auditee, atau manajemen. Kosongkan bila tidak perlu.
ADMIN_USER_ROLE=auditor

# Akun Infra Admin untuk developer (di atas System Admin). Kosongkan bila tidak perlu.
# Dibuat saat aplikasi jalan bila username ini belum ada.
INFRA_USERNAME=
INFRA_PASSWORD=
INFRA_EMAIL=

# Alamat aplikasi (dipakai di email pengingat)
APP_URL=http://localhost:3000
# true bila aplikasi diakses lewat HTTPS
COOKIE_SECURE=false
PORT=3000
APP_PORT=3000
MAX_UPLOAD_MB=20

# Opsional: email pengingat tindak lanjut harian. Kosongkan SMTP_HOST untuk menonaktifkan.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Audit Management <audit@perusahaan.co.id>
REMINDER_HOUR=8
